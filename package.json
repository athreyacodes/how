{
  "name": "how",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "prebuild": "node scripts/content.mjs",
    "prebuild:dev": "node scripts/content.mjs --drafts",
    "start": "npm run prebuild:dev && ng serve",
    "build": "npm run prebuild && ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "watch": "npm run prebuild:dev && ng build --watch --configuration development",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "layers-ui": "^0.26.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "~22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^22.10.0",
    "firebase-tools": "^14.0.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "typescript": "~6.0.3"
  }
}
